:38px;display:grid;grid-template-columns:18px minmax(0,1fr) auto;align-items:center;gap:7px;padding:0 9px;border:1px solid var(--line);border-radius:11px;background:rgba(255,255,255,.025);transition:.15s var(--ease)}.search-box:focus-within{border-color:rgba(179,149,250,.35);background:rgba(169,139,255,.045);box-shadow:0 0 0 3px rgba(128,96,233,.07)}.search-box svg{width:16px;height:16px;fill:none;stroke:#857a9b;stroke-width:1.8}.search-box input{min-width:0;border:0;outline:0;background:transparent;color:var(--text);font-size:10.5px}.search-box input::placeholder{color:#70677f}.search-box kbd{border:1px solid var(--line);border-radius:5px;padding:2px 5px;color:#71677f;background:rgba(255,255,255,.025);font-size:8px;font-family:inherit}
.library-tools{display:grid;gap:7px}.filter-chips{display:flex;gap:4px;overflow:hidden}.filter-chip{height:25px;padding:0 8px;border:0;border-radius:8px;background:transparent;color:#9288a6;font-size:9px;font-weight:750;cursor:pointer}.filter-chip:hover{color:var(--text);background:rgba(255,255,255,.035)}.filter-chip.active{color:#f9f6ff;background:linear-gradient(135deg,rgba(114,80,218,.82),rgba(157,126,239,.70));box-shadow:0 5px 13px rgba(91,57,192,.15)}
.sort-control{height:29px;display:flex;align-items:center;gap:5px;padding:0 7px;border:1px solid rgba(224,214,255,.07);border-radius:9px;background:rgba(255,255,255,.018);color:#82778f}.sort-control svg{width:13px;height:13px}.sort-control select{min-width:0;flex:1;border:0;outline:0;background:transparent;color:#9d92ae;font-size:9px;appearance:auto}.sort-control option{background:#171225;color:#f8f6ff}
.wallpaper-list{min-height:0;overflow-y:auto;padding:1px 2px 4px 0;scrollbar-width:thin;scrollbar-color:rgba(171,143,247,.25) transparent}.wallpaper-list::-webkit-scrollbar{width:5px}.wallpaper-list::-webkit-scrollbar-thumb{border-radius:999px;background:rgba(171,143,247,.27)}
.wallpaper-item{position:relative;width:100%;min-height:76px;margin:0 0 5px;padding:11px 12px 10px 15px;border:1px solid transparent;border-radius:12px;background:transparent;color:var(--text);text-align:left;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:9px;cursor:pointer;transition:background .15s var(--ease),border-color .15s var(--ease),box-shadow .15s var(--ease)}
.wallpaper-item::before{content:"";position:absolute;left:6px;top:19px;width:2px;height:38px;border-radius:999px;background:transparent}.wallpaper-item:hover{background:rgba(169,139,255,.040);border-color:rgba(220,209,255,.055)}.wallpaper-item.selected{background:linear-gradient(105deg,rgba(128,96,233,.14),rgba(169,139,255,.028));border-color:rgba(179,149,250,.19);box-shadow:inset 0 1px rgba(255,255,255,.025),0 8px 26px rgba(58,34,126,.08)}.wallpaper-item.selected::before{background:linear-gradient(#bea7ff,#7658df);box-shadow:0 0 10px rgba(169,139,255,.42)}
.wallpaper-main{min-width:0;display:grid;gap:8px}.wallpaper-main strong{overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;line-height:1.26;font-size:10.8px;font-weight:680}.wallpaper-sub{display:flex;align-items:center;gap:5px;color:#776d89;font-size:8.8px}.wallpaper-sub b{color:#c4b4f0;font-weight:700}.wallpaper-sub i{font-style:normal;color:#4f475c}.wallpaper-meta-chip{align-self:start;margin-top:1px;max-width:78px;padding:3px 6px;border:1px solid rgba(224,214,255,.07);border-radius:999px;color:#655d72;background:rgba(255,255,255,.018);font-size:7.8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.wallpaper-item.selected .wallpaper-meta-chip{color:#a99ace;border-color:rgba(177,149,246,.12);background:rgba(128,96,233,.05)}
.library-footer{padding:7px 3px 0;display:flex;align-items:center;justify-content:space-between;gap:10px;color:#675f74;font-size:8.8px;border-top:1px solid rgba(220,209,255,.045)}.mini-dot{width:4px;height:4px;border-radius:50%;background:#9679e9;box-shadow:0 0 9px rgba(150,121,233,.55)}

.workspace{min-width:0;min-height:0;overflow-y:auto;overflow-x:hidden;padding-right:3px;scrollbar-width:thin;scrollbar-color:rgba(171,143,247,.25) transparent}.workspace::-webkit-scrollbar{width:5px}.workspace::-webkit-scrollbar-thumb{border-radius:999px;background:rgba(171,143,247,.27)}.preview-card{min-height:0;border-radius:17px;padding:10px;display:grid;grid-template-rows:30px auto auto;gap:0;box-shadow:0 22px 70px rgba(2,1,8,.25),inset 0 1px rgba(255,255,255,.03)}
.preview-toolbar{display:flex;align-items:center;justify-content:space-between;padding:0 2px 7px}.preview-badges{display:flex;gap:5px;align-items:center}.badge{height:21px;padding:0 7px;border:1px solid rgba(224,214,255,.07);border-radius:7px;display:grid;place-items:center;background:rgba(255,255,255,.02);color:#82788f;font-size:8px;font-weight:750;text-transform:uppercase}.badge.accent{colo