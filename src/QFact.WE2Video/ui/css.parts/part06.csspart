:13px}.wallpaper-item{min-height:80px}
.preview-stage{width:min(100%,1120px);max-height:630px}.preview-stage.portrait{max-height:650px}.preview-stage.ultrawide{max-height:440px}

.capture-options{grid-template-columns:1fr 1fr}
.capture-option+.capture-option{border-left:1px solid rgba(224,214,255,.055)}

.manual-clean{margin-top:9px;border:1px solid rgba(211,198,255,.085);border-radius:14px;background:linear-gradient(120deg,rgba(128,96,233,.052),rgba(255,255,255,.012));backdrop-filter:blur(24px) saturate(122%);overflow:hidden}
.manual-clean-head{min-height:64px;padding:10px 12px;display:flex;align-items:center;justify-content:space-between;gap:14px;border-bottom:1px solid rgba(224,214,255,.055)}
.manual-clean-title{min-width:0;display:flex;align-items:center;gap:10px}.manual-clean-title>div:last-child{min-width:0}.manual-clean-title-line{display:flex;align-items:center;gap:7px;min-width:0;flex-wrap:wrap}.manual-clean-title-line strong{font-size:10.5px}.manual-clean-title p{margin:3px 0 0;max-width:780px;color:#796f88;font-size:8px;line-height:1.4}
.clean-count,.clean-selected-count{padding:2px 6px;border-radius:999px;background:rgba(255,255,255,.035);color:#82768f;font-size:7px;font-weight:750}.clean-count.active{background:rgba(144,108,235,.12);color:#cdbbff}.clean-selected-count.active{background:rgba(78,210,139,.09);color:#9ae0b9}
.manual-clean-actions{display:flex;align-items:center;gap:6px;flex:0 0 auto}.manual-clean-actions button{height:29px;padding:0 9px;border:1px solid rgba(224,214,255,.08);border-radius:8px;background:rgba(255,255,255,.025);color:#a69ab7;font-size:7.8px;cursor:pointer;transition:.14s var(--ease)}.manual-clean-actions button:hover:not(:disabled){border-color:rgba(179,149,250,.3);background:rgba(153,118,238,.08);color:#e1d8f7}.manual-clean-actions button.ghost{background:transparent;color:#786f84}.manual-clean-actions button:disabled{opacity:.34;cursor:default}
.manual-clean-grid{max-height:300px;overflow:auto;padding:9px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;scrollbar-width:thin;scrollbar-color:rgba(171,143,247,.25) transparent}.manual-clean-grid::-webkit-scrollbar{width:5px}.manual-clean-grid::-webkit-scrollbar-thumb{border-radius:999px;background:rgba(171,143,247,.27)}
.clean-empty{grid-column:1/-1;min-height:62px;display:grid;place-items:center;padding:14px;border:1px dashed rgba(224,214,255,.075);border-radius:10px;color:#746a82;background:rgba(255,255,255,.012);font-size:8.4px;text-align:center}
.manual-clean-item{min-width:0;min-height:58px;padding:8px 9px;display:grid;grid-template-columns:18px minmax(0,1fr) auto;gap:8px;align-items:center;border:1px solid rgba(224,214,255,.065);border-radius:10px;background:rgba(255,255,255,.018);cursor:pointer;transition:border-color .14s var(--ease),background .14s var(--ease),transform .14s var(--ease)}
.manual-clean-item:hover{border-color:rgba(179,149,250,.22);background:rgba(145,108,235,.05)}.manual-clean-item:has(input:checked){border-color:rgba(167,135,247,.28);background:linear-gradient(105deg,rgba(128,96,233,.12),rgba(255,255,255,.022));box-shadow:inset 0 1px rgba(255,255,255,.025)}.manual-clean-item.currently-off{opacity:.72}
.manual-clean-item>input{position:absolute;opacity:0;pointer-events:none}.manual-check{width:17px;height:17px;border:1px solid rgba(224,214,255,.16);border-radius:5px;background:rgba(255,255,255,.025);display:grid;place-items:center;transition:.14s}.manual-check::after{content:'✓';font-size:11px;line-height:1;color:#fff;opacity:0;transform:scale(.7);transition:.14s}.manual-clean-item>input:checked+.manual-check{border-color:rgba(179,149,250,.45);background:linear-gradient(135deg,#7253d8,#9d7aea);box-shadow:0 4px 12px rgba(104,67,210,.17)}.manual-clean-item>input:checked+.manual-check::after{opacity:1;transform:none}
.manual-clean-copy{min-width:0;display:grid;gap:3px}.manual-clean-copy strong{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#e9e2f8;font-size:9px;font-weight:680}.manual-clean-copy small{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#6f667b;font-size:7px}
.manual-clean-meta{min-width:0;max-width:150px;display:grid;justify-items:end;gap:3px}.module-badge{max-width:150px;padding:3px 6px;border-radius:999px;background:rgba(148,112,238,.10);color:#bca8f1;font-size:6.8px;font-weight:750;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.module-badge.switch-badge{background:rgba(255,255,255,.03);color:#776d83}.clean-cascade{max-width:145px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#62596f;font-size:6.5px}

@media(max-width:1360px){.main-grid{grid-template-columns:300px minmax(0,1fr)}.manual-clean-grid{grid-template-columns:1fr}.path-button span{display:none}.path-button{width:31px;padding