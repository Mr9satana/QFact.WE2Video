r:#e6ddff;border-color:rgba(179,149,250,.18);background:rgba(128,96,233,.13)}.badge.subtle{color:#6c6378}.text-button{height:27px;padding:0 9px;display:flex;align-items:center;gap:5px;color:#8c819b;font-size:8.5px}.text-button svg{width:13px;height:13px}
.preview-stage{--preview-ratio:1.7777778;position:relative;width:min(100%,940px);aspect-ratio:var(--preview-ratio);min-height:220px;max-height:520px;margin:2px auto 0;border-radius:14px;overflow:hidden;display:grid;place-items:center;background:#09080d;border:1px solid rgba(255,255,255,.035);box-shadow:inset 0 1px rgba(255,255,255,.025),0 18px 48px rgba(0,0,0,.18);transition:aspect-ratio .18s var(--ease),width .18s var(--ease)}.preview-stage.portrait{width:min(100%,430px);max-height:560px}.preview-stage.ultrawide{width:100%;min-height:190px;max-height:380px}.preview-backdrop{position:absolute;inset:-34px;background-position:center;background-size:cover;filter:blur(40px) saturate(.72) brightness(.34);opacity:.52;transform:scale(1.08)}.preview-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(5,4,8,.03),rgba(5,4,8,.09)),radial-gradient(circle at center,transparent 20%,rgba(5,4,8,.16) 100%)}.preview-stage>img#previewImage{position:absolute;z-index:2;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;filter:none}.preview-empty{position:relative;z-index:2;display:grid;justify-items:center;gap:10px;color:#6f667c;font-size:10px}.preview-empty img{width:54px;height:54px;object-fit:contain;opacity:.56;filter:drop-shadow(0 8px 18px rgba(54,43,255,.16))}
.wallpaper-summary{padding:12px 4px 2px;min-width:0}.title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.title-block{min-width:0}.title-block h1{margin:0;max-width:840px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:19px;letter-spacing:-.035em}.title-block p{margin:3px 0 0;color:#7e748d;font-size:9px}.resolution-hero{flex:0 0 auto;text-align:right;display:grid;gap:1px}.resolution-hero span{color:#675f74;font-size:7.5px;text-transform:uppercase;letter-spacing:.11em}.resolution-hero strong{color:#cbbaff;font-size:13px}
.meta-strip{margin-top:10px;border-top:1px solid rgba(224,214,255,.055);border-bottom:1px solid rgba(224,214,255,.055);display:grid;grid-template-columns:minmax(150px,1fr) minmax(130px,.85fr) minmax(220px,1.35fr)}.meta-cell{min-width:0;padding:8px 10px 8px 0;display:grid;gap:2px}.meta-cell+.meta-cell{padding-left:12px;border-left:1px solid rgba(224,214,255,.055)}.meta-cell>span{color:#655d73;font-size:7.5px;text-transform:uppercase;letter-spacing:.1em;font-weight:800}.meta-cell strong,.meta-cell small{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.meta-cell strong{font-size:10.5px}.meta-cell small{color:#786e88;font-size:8.4px}.tag-row{display:flex;flex-wrap:wrap;gap:4px;margin-top:7px;max-height:44px;overflow:hidden}.tag-row span{padding:3px 6px;border:1px solid rgba(224,214,255,.055);border-radius:999px;color:#6f667d;background:rgba(255,255,255,.015);font-size:7.5px}.metadata-note{margin:7px 0 0;color:#71677f;font-size:8px;line-height:1.35}

.export-card{margin-top:10px;border-radius:17px;padding:11px 12px 10px;box-shadow:0 16px 48px rgba(2,1,8,.20),inset 0 1px rgba(255,255,255,.03)}.export-head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px}.format-description{max-width:48%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#766d85;font-size:8px}.export-controls{margin-top:9px;display:grid;grid-template-columns:minmax(170px,1.12fr) minmax(180px,1.12fr) 112px 136px;gap:8px}.field{min-width:0;display:grid;gap:4px}.field>span{color:#81768f;font-size:8px;font-weight:650}.field select,.field input,.suffix-input{height:34px;border:1px solid rgba(224,214,255,.085);border-radius:9px;background:rgba(255,255,255,.025);color:var(--text);transition:.14s var(--ease)}.field select{width:100%;padding:0 9px}.field input{width:100%;padding:0 9px;outline:0}.field select:focus,.field input:focus,.suffix-input:focus-within{border-color:rgba(179,149,250,.38);box-shadow:0 0 0 3px rgba(128,96,233,.07);background:rgba(169,139,255,.04)}.field select option{background:#171225;color:#f8f6ff}.field small{height:10px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#625a6f;font-size:7.5px}.suffix-input{display:flex;align-items:center}.suffix-input input{height:100%;border:0!important;background:transparent!important;box-shadow:none!important}.suffix-input em{padding-right:8px;color:#675e74;font-style:normal;font-size:7.5px}.custom-resolution{margin-top:7px;display:grid;grid-template-columns:1fr 20px 1fr;align-items:end;gap:6px;max-width:420px}.dimension-x{height:34px;display:grid;place-items:center;color:#6b6278}
.preset-export{margin-top:9px;border:1px solid rgba(169,139,25