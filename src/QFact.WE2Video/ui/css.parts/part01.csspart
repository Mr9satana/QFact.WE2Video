:root {
  --bg:#080611;
  --bg2:#0f0a1b;
  --surface:rgba(24,18,41,.56);
  --surface-strong:rgba(20,15,35,.76);
  --surface-soft:rgba(255,255,255,.028);
  --line:rgba(224,214,255,.10);
  --line-strong:rgba(190,165,255,.22);
  --text:#f8f5ff;
  --muted:#b7aecf;
  --muted-2:#776e8d;
  --accent:#8060e9;
  --accent-2:#b395fa;
  --accent-3:#d5c8ff;
  --success:#4ed28b;
  --danger:#ff668c;
  --warning:#f0bd6a;
  --shadow:0 24px 80px rgba(2,1,8,.35);
  --ease:cubic-bezier(.2,.8,.2,1);
}
*{box-sizing:border-box}
html,body{width:100%;height:100%;margin:0;overflow:hidden;background:var(--bg);color:var(--text);font-family:"Segoe UI Variable","Segoe UI",Inter,system-ui,sans-serif;font-size:13px}
button,input,select{font:inherit}
button{color:inherit}
button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid rgba(179,149,250,.74);outline-offset:2px}
.hidden{display:none!important}

body{background:
  radial-gradient(900px 460px at 76% -12%,rgba(132,89,232,.16),transparent 68%),
  radial-gradient(700px 420px at -7% 92%,rgba(73,45,151,.12),transparent 70%),
  linear-gradient(145deg,#080611,#0d0916 48%,#090711)}
.ambient{position:fixed;pointer-events:none;border-radius:50%;filter:blur(70px);opacity:.42;z-index:0}
.ambient-a{width:360px;height:360px;right:12%;top:-210px;background:#7955df}
.ambient-b{width:300px;height:300px;left:-160px;bottom:-150px;background:#4d2bb1}
.ambient-c{width:240px;height:240px;right:-120px;bottom:10%;background:#a271ec;opacity:.16}

.app-shell{position:relative;z-index:1;width:100%;height:100%;padding:14px;display:grid;grid-template-rows:58px minmax(0,1fr);gap:10px}
.glass{border:1px solid var(--line);background:linear-gradient(145deg,rgba(255,255,255,.052),rgba(116,83,199,.018)),var(--surface);box-shadow:var(--shadow),inset 0 1px rgba(255,255,255,.035);backdrop-filter:blur(26px) saturate(125%);-webkit-backdrop-filter:blur(26px) saturate(125%)}
.topbar{border-radius:17px;display:flex;align-items:center;justify-content:space-between;padding:8px 11px 8px 9px;box-shadow:0 14px 44px rgba(2,1,8,.20),inset 0 1px rgba(255,255,255,.04)}
.brand{display:flex;align-items:center;gap:10px;min-width:0}
.brand-mark{width:40px;height:40px;display:grid;place-items:center;border-radius:12px;background:linear-gradient(145deg,rgba(255,255,255,.08),rgba(130,93,224,.05));border:1px solid rgba(188,167,255,.14);box-shadow:0 8px 22px rgba(91,58,192,.17);overflow:hidden}
.brand-mark img{width:34px;height:34px;object-fit:contain;filter:drop-shadow(0 4px 7px rgba(66,48,255,.20))}
.brand-copy{display:grid;gap:1px;min-width:0}.brand-copy strong{font-size:16px;letter-spacing:-.025em}.brand-copy span{font-size:10px;color:var(--muted)}
.top-actions{display:flex;align-items:center;gap:8px}
.engine-status{height:31px;padding:0 11px;border:1px solid var(--line);border-radius:10px;display:flex;align-items:center;gap:7px;background:rgba(255,255,255,.03);color:var(--muted);font-size:10px;font-weight:700}
.engine-status i{width:6px;height:6px;border-radius:50%;background:var(--warning);box-shadow:0 0 12px currentColor}.engine-status.ready{color:#b9f5d5;border-color:rgba(78,210,139,.16);background:rgba(78,210,139,.06)}.engine-status.ready i{background:var(--success)}.engine-status.error{color:#ffc0d0;border-color:rgba(255,102,140,.18);background:rgba(255,102,140,.06)}.engine-status.error i{background:var(--danger)}
.icon-button,.text-button,.mini-button,.clean-details-toggle,.last-export button{border:1px solid var(--line);background:rgba(255,255,255,.035);border-radius:10px;cursor:pointer;transition:.15s var(--ease)}
.icon-button:hover,.text-button:hover,.mini-button:hover,.clean-details-toggle:hover,.last-export button:hover{border-color:rgba(185,158,255,.35);background:rgba(164,132,246,.08)}
.icon-button{width:31px;height:31px;padding:7px}.icon-button svg,.text-button svg,.folder-box svg,.sort-control svg{width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}

.main-grid{min-height:0;display:grid;grid-template-columns:308px minmax(0,1fr);gap:10px}
.library-panel{min-height:0;border-radius:17px;padding:14px 11px 9px;display:grid;grid-template-rows:auto auto auto minmax(0,1fr) auto;gap:9px;box-shadow:0 18px 55px rgba(2,1,8,.22),inset 0 1px rgba(255,255,255,.03)}
.section-head{display:flex;align-items:flex-end;justify-content:space-between;padding:0 2px}.eyebrow{display:block;color:#756a8b;font-size:8px;font-weight:900;letter-spacing:.14em}.section-head h2,.export-head h2{margin:2px 0 0;font-size:17px;letter-spacing:-.03em}.count-pill{min-width:27px;height:22px;padding:0 8px;border:1px solid rgba(177,149,246,.18);border-radius:999px;background:rgba(145,105,238,.08);display:grid;place-items:center;color:#cab9ff;font-size:10px;font-weight:800}
.search-box{height: