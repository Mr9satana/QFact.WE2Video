5,.075);border-radius:12px;background:linear-gradient(110deg,rgba(128,96,233,.042),rgba(255,255,255,.008));overflow:hidden}.preset-main{min-height:50px;padding:8px 10px;display:grid;grid-template-columns:28px minmax(0,1fr) auto;align-items:center;gap:9px}.preset-icon{width:28px;height:28px;border:1px solid rgba(179,149,250,.13);border-radius:9px;background:rgba(128,96,233,.08);display:grid;place-items:center;color:#cbb9ff}.preset-icon svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.preset-copy{min-width:0}.preset-title-line{display:flex;align-items:center;gap:7px}.preset-title-line strong{font-size:10px}.preset-badge{padding:2px 6px;border-radius:999px;background:rgba(78,210,139,.07);color:#84cfa8;font-size:7.2px}.preset-copy p{margin:2px 0 0;color:#72687f;font-size:7.8px}.switch{position:relative;width:36px;height:20px}.switch input{position:absolute;opacity:0}.switch span{position:absolute;inset:0;border:1px solid rgba(224,214,255,.10);border-radius:999px;background:rgba(255,255,255,.035);cursor:pointer;transition:.15s}.switch span::after{content:"";position:absolute;width:14px;height:14px;left:2px;top:2px;border-radius:50%;background:#7a7188;transition:.15s}.switch input:checked+span{border-color:rgba(179,149,250,.25);background:linear-gradient(135deg,#7253d8,#9d7aea)}.switch input:checked+span::after{transform:translateX(16px);background:white;box-shadow:0 2px 8px rgba(0,0,0,.22)}.preset-panel{border-top:1px solid rgba(224,214,255,.045);padding:8px 10px 9px 47px;display:grid;grid-template-columns:minmax(210px,320px) minmax(0,1fr);gap:10px;align-items:center;transition:.15s}.preset-panel.disabled{opacity:.36;pointer-events:none}.preset-name-field{display:grid;gap:4px}.preset-name-field>span{color:#81768f;font-size:8px;font-weight:650}.preset-name-field input{height:34px;width:100%;padding:0 9px;border:1px solid rgba(224,214,255,.085);border-radius:9px;background:rgba(255,255,255,.025);color:var(--text);outline:0}.preset-name-field input:focus{border-color:rgba(179,149,250,.38);box-shadow:0 0 0 3px rgba(128,96,233,.07);background:rgba(169,139,255,.04)}.preset-help{color:#6f667d;font-size:7.6px;line-height:1.42}.preset-help code{padding:1px 4px;border-radius:5px;background:rgba(255,255,255,.035);color:#aa96df;font-family:Consolas,monospace;font-size:7.4px}
.export-bottom{margin-top:9px;display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:10px;align-items:stretch}.folder-control{min-width:0;display:grid;grid-template-columns:auto minmax(0,1fr) auto auto;gap:6px;align-items:center}.folder-label{color:#675f74;font-size:7.5px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.folder-box{height:39px;min-width:0;padding:0 10px;border:1px solid rgba(224,214,255,.07);border-radius:9px;background:rgba(255,255,255,.018);display:flex;align-items:center;gap:7px;color:#83788f}.folder-box svg{width:14px;height:14px;flex:0 0 auto}.folder-box span{min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:8.5px}.mini-button{height:39px;padding:0 10px;color:#a297b2;font-size:8px}.mini-button.ghost{color:#746a80;background:transparent}.export-button{position:relative;overflow:hidden;height:46px;padding:0 14px;border:1px solid transparent;border-radius:11px;background:linear-gradient(135deg,#7556df,#a487f3);box-shadow:0 10px 25px rgba(104,67,210,.22);color:white;display:flex;align-items:center;justify-content:space-between;gap:12px;cursor:pointer;transition:.15s var(--ease)}.export-button:hover:not(:disabled){transform:translateY(-1px);box-shadow:0 14px 30px rgba(104,67,210,.28);filter:brightness(1.04)}.export-button:disabled{opacity:.42;cursor:default;box-shadow:none}.export-button-copy{min-width:0;text-align:left;display:grid;gap:1px}.export-button-copy strong{font-size:10px}.export-button-copy small{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#e7ddff;font-size:7.4px}.export-arrow{font-size:16px}.export-progress{position:absolute;left:0;bottom:0;width:0;height:2px;background:rgba(255,255,255,.72)}body.busy .export-progress{width:78%;transition:width 15s linear}.last-export{margin-top:7px;padding-top:7px;border-top:1px solid rgba(224,214,255,.05);display:flex;align-items:center;justify-content:space-between;gap:8px}.last-export>div{min-width:0;display:grid;gap:1px}.last-export span{color:#665e72;font-size:7px}.last-export strong{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:8px}.last-export button{height:27px;padding:0 8px;color:#91869f;font-size:7.5px}

.toast{position:fixed;z-index:300;right:20px;bottom:84px;width:min(370px,calc(100vw - 40px));min-height:54px;padding:10px 12px;border:1px solid rgba(220,209,255,.13);border-radius:13px;background:linear-gradient(145deg,rgba(31,24